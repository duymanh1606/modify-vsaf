# =============================================================================
# VDS PDF Orchestrator - Environment Configuration
# =============================================================================
# P0 Change (2026-04-25): Uses shared vds-redis for session cache.
# See docker/MIGRATION.md for migration details.
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Shared Redis Configuration (P0: Uses shared vds-redis)
# -----------------------------------------------------------------------------
# PDF orchestrator uses Redis DB 7 for session cache.

# Base Redis URL
REDIS_URL=redis://localhost:6379

# PDF-specific Redis DB (DB 7)
REDIS_PDF_SESSION_DB=7

# -----------------------------------------------------------------------------
# PDF Processing Configuration
# -----------------------------------------------------------------------------
# Max file size for PDF processing (bytes)
PDF_MAX_FILE_SIZE=52428800  # 50MB

# Processing timeout (seconds)
PDF_PROCESSING_TIMEOUT=300

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API host and port
API_HOST=0.0.0.0
API_PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
