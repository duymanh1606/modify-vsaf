; =============================================================================
; VDS PgBouncer userlist.txt TEMPLATE
; =============================================================================
; This file is a TEMPLATE. The real `userlist.txt` (no `.template` suffix)
; must be generated by an init script at deploy time and is NEVER committed.
;
; Format: "username" "password-hash"
;   - username : matches Postgres role (or pgbouncer_admin/pgbouncer_stats)
;   - password-hash : SCRAM-SHA-256 hash from pg_shadow.passwd
;
; Generation pattern (run once at deploy time):
;   docker exec vds-postgres psql -U postgres -t -A -c \
;     "SELECT '\"' || usename || '\" \"' || passwd || '\"' \
;      FROM pg_shadow \
;      WHERE usename IN ('postgres','pgbouncer_admin','pgbouncer_stats','pgbouncer_auth') \
;        AND passwd IS NOT NULL" \
;     > docker/infrastructure/pgbouncer/userlist.txt
;
; The `pgbouncer_admin`, `pgbouncer_stats`, `pgbouncer_auth` users must be
; created in Postgres before generating userlist.txt:
;
;   CREATE USER pgbouncer_admin WITH PASSWORD '<strong-password>';
;   CREATE USER pgbouncer_stats WITH PASSWORD '<strong-password>';
;   CREATE USER pgbouncer_auth WITH PASSWORD '<strong-password>';
;   GRANT pg_read_all_settings TO pgbouncer_stats;
;
; The `auth_query` in pgbouncer.ini handles per-service password lookup
; transparently — only the bootstrap admin/stats/auth users need entries here.
;
; The actual `userlist.txt` file is gitignored and stays out of version control.
; =============================================================================

; Example format (DO NOT use these placeholder hashes; generate real ones):
; "pgbouncer_admin" "SCRAM-SHA-256$4096:placeholder-salt$placeholder-stored:placeholder-server-key"
; "pgbouncer_stats" "SCRAM-SHA-256$4096:placeholder-salt$placeholder-stored:placeholder-server-key"
; "pgbouncer_auth"  "SCRAM-SHA-256$4096:placeholder-salt$placeholder-stored:placeholder-server-key"
